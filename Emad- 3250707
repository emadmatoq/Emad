<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personal Portfolio</title>
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            background-color: #eef2f5;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            color: #333;
        }
        .main-header {
            background: linear-gradient(135deg, #1e3c72, #2a5298);
            color: #fff;
            text-align: center;
            padding: 35px 15px;
        }
        .main-header h1 {
            margin: 0 0 10px 0;
            font-size: 32px;
        }
        .top-nav {
            background-color: #0f172a;
            display: flex;
            justify-content: center;
            gap: 20px;
            padding: 12px;
        }
        .top-nav a {
            color: #cbd5e1;
            text-decoration: none;
            font-weight: bold;
            padding: 6px 12px;
            border-radius: 4px;
            transition: all 0.3s ease;
        }
        .top-nav a:hover {
            color: #fff;
            background-color: #334155;
        }
        .wrapper {
            max-width: 850px;
            margin: 40px auto;
            background-color: #ffffff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }
        .section-title {
            color: #1e293b;
            border-left: 4px solid #2563eb;
            padding-left: 10px;
            font-size: 22px;
            margin-top: 30px;
        }
        p {
            font-size: 16px;
            line-height: 1.8;
            color: #475569;
        }
        .profile-img {
            max-width: 100%;
            height: auto;
            width: 320px;
            border-radius: 8px;
            border: 3px solid #e2e8f0;
        }
        .btn-action {
            background-color: #2563eb;
            color: #fff;
            border: none;
            padding: 10px 20px;
            font-size: 15px;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.2s ease;
        }
        .btn-action:hover {
            background-color: #1d4ed8;
        }
        .custom-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        .custom-table th, .custom-table td {
            border: 1px solid #cbd5e1;
            padding: 12px;
            text-align: center;
        }
        .custom-table th {
            background-color: #f1f5f9;
            color: #0f172a;
        }
        .form-group {
            margin-bottom: 15px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        input, select, textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 14px;
        }
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #2563eb;
        }
        .media-container {
            margin-top: 15px;
        }
        footer {
            background-color: #0f172a;
            color: #94a3b8;
            text-align: center;
            padding: 18px;
            margin-top: 40px;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <header class="main-header">
        <h1>My Personal Website</h1>
        <p>Welcome to my online portfolio</p>
    </header>

    <!-- Navigation Bar -->
    <nav class="top-nav">
        <a href="#main-info">Home</a>
        <a href="#skills">Skills</a>
        <a href="#contact-section">Contact</a>
        <a href="https://www.google.com" target="_blank">Search Engine</a>
    </nav>

    <!-- Main Content Container -->
    <div class="wrapper">
        
        <!-- About Section -->
        <h2 id="main-info" class="section-title">About Me</h2>
        <p>
            This website was built to demonstrate basic HTML elements and CSS styling techniques, featuring a clean layout and responsive structure.
        </p>

        <!-- Image Section -->
        <h2 class="section-title">Profile Picture</h2>
        <img class="profile-img" src="image.jpg" alt="Profile Picture">

        <!-- External Link & Button -->
        <h2 class="section-title">Quick Links</h2>
        <p>
            You can visit the search engine by visiting <a href="https://www.google.com" target="_blank">this link</a>.
        </p>
        <button class="btn-action" type="button">Click to Interact</button>

        <!-- Lists Section -->
        <h2 id="skills" class="section-title">Personal Interests</h2>
        <ul>
            <li>Web Development</li>
            <li>Reading & Research</li>
            <li>Graphic Design</li>
        </ul>

        <h2 class="section-title">Steps to Learn Coding</h2>
        <ol>
            <li>Understand the Fundamentals</li>
            <li>Build Hands-on Projects</li>
            <li>Stay Updated with Tech Trends</li>
        </ol>

        <!-- Data Table -->
        <h2 class="section-title">Student Records</h2>
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Age</th>
                    <th>Grade Level</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Omar</td>
                    <td>21</td>
                    <td>Excellent</td>
                </tr>
                <tr>
                    <td>Sarah</td>
                    <td>20</td>
                    <td>Very Good</td>
                </tr>
            </tbody>
        </table>

        <!-- Form Section -->
        <h2 id="contact-section" class="section-title">Contact Form</h2>
        <form action="#">
            <div class="form-group">
                <label for="username">Full Name:</label>
                <input type="text" id="username" placeholder="Enter your full name">
            </div>

            <div class="form-group">
                <label for="useremail">Email Address:</label>
                <input type="email" id="useremail" placeholder="example@mail.com">
            </div>

            <div class="form-group">
                <label for="pass">Password:</label>
                <input type="password" id="pass" placeholder="••••••••">
            </div>

            <div class="form-group">
                <label for="country">Country:</label>
                <select id="country">
                    <option value="jo">Jordan</option>
                    <option value="sa">Saudi Arabia</option>
                    <option value="pal">Palestine</option>
                    <option value="eg">Egypt</option>
                </select>
            </div>

            <div class="form-group">
                <label for="msg">Message:</label>
                <textarea id="msg" rows="4" placeholder="Write your message here..."></textarea>
            </div>

            <button class="btn-action" type="submit">Submit Form</button>
        </form>

        <!-- Multimedia Section -->
        <h2 class="section-title">Media Files</h2>
        <div class="media-container">
            <video width="100%" controls>
                <source src="video.mp4" type="video/mp4">
                Your browser does not support the video tag.
            </video>
        </div>

        <div class="media-container">
            <audio controls>
                <source src="audio.mp3" type="audio/mpeg">
                Your browser does not support the audio element.
            </audio>
        </div>

    </div>

    <!-- Footer Section -->
    <footer>
        <p>© 2026 All Rights Reserved - My Personal Website</p>
    </footer>

</body>
</html>
